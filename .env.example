# --- Django ---
# Mahalliy ishlab chiqishda bo'sh qoldirsangiz ham bo'ladi (DEBUG=1). DEBUG=0 da MAJBURIY, kamida 32 belgi:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Bot tokenlarini bazada shifrlash kaliti (bo'sh = SECRET_KEY dan hosil qilinadi).
# Kalit o'zgarsa yoki yo'qolsa, tokenlarni panelda qayta kiritish kerak bo'ladi.
TOKEN_ENCRYPTION_KEY=

# Ixtiyoriy (faqat HTTPS orqasida ishga tushirganda): DJANGO_BEHIND_PROXY=1, DJANGO_FORCE_HTTPS=1,
# DJANGO_CSRF_TRUSTED_ORIGINS=https://sizning-domen.uz, DJANGO_TRUST_X_FORWARDED_FOR=1

# --- Telegram bot (ixtiyoriy) ---
# Token panelda ham kiritiladi (bazada shifrlanadi). Panelda kiritilmagan bo'lsa, shu qiymat ishlatiladi.
TELEGRAM_BOT_TOKEN=
# Shu token qaysi do'konga (id). Bo'sh = tokeni yo'q birinchi faol do'kon
TELEGRAM_BOT_SHOP_ID=
# Egasining Telegram ID si (ulash kodisiz bildirishnoma olish uchun)
TELEGRAM_OWNER_ID=

# --- Ma'lumotlar bazasi ---
# Bo'sh qoldirilsa SQLite (db.sqlite3) ishlatiladi.
# PostgreSQL uchun: postgres://user:password@localhost:5432/sotuvchi_ai
DATABASE_URL=

# --- LLM provayderi ---
# gemini | groq | ollama | mock
# "mock" - tashqi API kerak emas, oddiy qoidalar asosida javob beradi (demo va testlar uchun)
LLM_PROVIDER=mock

# Gemini (bepul tarif): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Groq (bepul tarif): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama (mahalliy)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Bir so'rov uchun kutish vaqti (soniya)
LLM_TIMEOUT=30
