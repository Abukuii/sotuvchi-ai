# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# --- Ma'lumotlar bazasi ---
# Bo'sh qoldirilsa SQLite (db.sqlite3) ishlatiladi.
# PostgreSQL uchun: postgres://user:password@localhost:5432/sotuvchi_ai
DATABASE_URL=

# --- LLM provayderi ---
# gemini | groq | ollama | mock
# "mock" - tashqi API kerak emas, oddiy qoidalar asosida javob beradi (demo va testlar uchun)
LLM_PROVIDER=mock

# Gemini (bepul tarif): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Groq (bepul tarif): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama (mahalliy)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Bir so'rov uchun kutish vaqti (soniya)
LLM_TIMEOUT=30
